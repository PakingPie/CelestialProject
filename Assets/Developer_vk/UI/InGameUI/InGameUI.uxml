<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; flex-direction: column;">
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: auto;">
                <ui:Slider label="Slider" value="42" high-value="100" direction="Vertical" style="flex-direction: column; align-items: auto; top: auto; bottom: 5%; height: 40%; width: 25%; min-width: 24px; left: 10%;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; justify-content: flex-start; align-items: center; align-self: auto; align-content: auto; bottom: 5%;">
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; align-items: flex-end; width: 100%; justify-content: space-evenly; bottom: auto; top: auto; align-self: auto; flex-basis: auto;">
                    <ui:Tab label="Types&#10;" style="min-width: 24px; min-height: auto; max-height: none; max-width: 150px; font-size: 12px;">
                        <ui:Button text="AP" name="MainGunBtn_AP" style="aspect-ratio: 1; max-width: 150px; max-height: 150px; min-width: 24px; min-height: 24px;"/>
                        <ui:Button text="HE" name="MainGunBtn_HE" style="aspect-ratio: 1; max-width: 150px; max-height: 150px; min-width: 24px; min-height: 24px;"/>
                        <ui:Button text="Plasma" name="MainGunBtn_Pla" style="aspect-ratio: 1; max-width: 150px; max-height: 150px; min-width: 24px; min-height: 24px;"/>
                    </ui:Tab>
                    <ui:Tab label="Types" style="min-width: 24px; max-width: 150px; font-size: 12px;">
                        <ui:Button text="AP" name="SideGunBth_AP" style="aspect-ratio: 1; max-width: 150px; max-height: 150px; min-width: 24px; min-height: 24px;"/>
                        <ui:Button text="HE" name="SideGunBtn_HE" style="aspect-ratio: 1; max-width: 150px; max-height: 150px; min-width: 24px; min-height: 24px;"/>
                    </ui:Tab>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: space-evenly; align-items: auto; width: 100%;">
                    <ui:Button text="Button" style="aspect-ratio: 1; max-width: 150px; max-height: 150px; min-width: 24px; min-height: 24px;"/>
                    <ui:Button text="Button" style="aspect-ratio: 1; min-width: 24px; min-height: 24px; max-width: 150px; max-height: 150px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
