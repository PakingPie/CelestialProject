<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; visibility: visible; justify-content: space-evenly; align-items: center; align-content: center; flex-direction: column; flex-shrink: 1; align-self: stretch; flex-basis: auto; height: auto; margin-top: 10%; margin-bottom: 10%; margin-left: 10%; margin-right: 10%; padding-left: 0;">
        <ui:Button text="Start" name="StartBn" style="flex-direction: column; left: auto; right: auto; width: 30%; align-items: center; justify-content: center; bottom: auto; white-space: pre; align-self: center; aspect-ratio: 4; min-width: auto; height: auto; position: relative; top: auto; font-size: 50%;"/>
        <ui:Button text="Options" name="OptionsBn" style="justify-content: center; width: 30%; align-items: center; align-self: center; min-width: auto; aspect-ratio: 4; height: auto; top: auto; bottom: auto; align-content: center; font-size: 50%;"/>
        <ui:Button text="Exit" name="ExitBn" style="justify-content: center; width: 30%; align-items: center; align-self: center; min-width: auto; aspect-ratio: 4; height: auto; top: auto; font-size: 50%;"/>
    </ui:VisualElement>
</ui:UXML>
