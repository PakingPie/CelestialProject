// WorleyNoiseCompute.compute
#pragma kernel GenerateWorleyNoise
#pragma kernel GenerateMultiOctaveWorley

// Output texture
RWTexture3D<float4> _ResultTexture;

// Parameters
int _Resolution;
int _NumCells;
float _Persistence;
int _Octaves;
int _Seed;

// Random hash function
float3 Hash3D(float3 p, int seed)
{
    p = frac(p * float3(443.897, 441.423, 437.195));
    p += dot(p, p.yxz + 19.19 + seed);
    return frac(float3(
        (p.x + p.y) * p.z,
        (p.x + p.z) * p.y,
        (p.y + p.z) * p.x
    ));
}

// Generate random points within each cell
float3 GetCellPoint(int3 cell, int numCells, int seed)
{
    // Wrap cells for seamless tiling
    int3 wrappedCell = ((cell % numCells) + numCells) % numCells;
    
    // Generate deterministic random offset within cell
    float3 cellBase = float3(wrappedCell);
    float3 randomOffset = Hash3D(cellBase, seed);
    
    return (cellBase + randomOffset) / float(numCells);
}

// Calculate minimum distance to cell points (Worley F1)
float WorleyNoise(float3 uvw, int numCells, int seed)
{
    float3 cellCoord = uvw * numCells;
    int3 baseCell = floor(cellCoord);
    
    float minDist = 1.0;
    
    // Check 3x3x3 neighborhood
    for (int x = -1; x <= 1; x++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int z = -1; z <= 1; z++)
            {
                int3 neighborCell = baseCell + int3(x, y, z);
                float3 cellPoint = GetCellPoint(neighborCell, numCells, seed);
                
                // Handle wrapping for seamless tiling
                float3 diff = cellPoint - uvw;
                
                // Check wrapped distances for seamless tiling
                for (int wx = -1; wx <= 1; wx++)
                {
                    for (int wy = -1; wy <= 1; wy++)
                    {
                        for (int wz = -1; wz <= 1; wz++)
                        {
                            float3 wrappedDiff = diff + float3(wx, wy, wz);
                            float dist = length(wrappedDiff);
                            minDist = min(minDist, dist);
                        }
                    }
                }
            }
        }
    }
    
    // Normalize based on expected cell size
    return saturate(minDist * numCells * 0.5);
}

// Calculate F2 - F1 (cellular pattern with both features)
float2 WorleyNoiseF1F2(float3 uvw, int numCells, int seed)
{
    float3 cellCoord = uvw * numCells;
    int3 baseCell = floor(cellCoord);
    
    float minDist1 = 1.0; // F1 - closest
    float minDist2 = 1.0; // F2 - second closest
    
    // Check 3x3x3 neighborhood
    for (int x = -1; x <= 1; x++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int z = -1; z <= 1; z++)
            {
                int3 neighborCell = baseCell + int3(x, y, z);
                float3 cellPoint = GetCellPoint(neighborCell, numCells, seed);
                
                float3 diff = cellPoint - uvw;
                
                // Check wrapped distances
                for (int wx = -1; wx <= 1; wx++)
                {
                    for (int wy = -1; wy <= 1; wy++)
                    {
                        for (int wz = -1; wz <= 1; wz++)
                        {
                            float3 wrappedDiff = diff + float3(wx, wy, wz);
                            float dist = length(wrappedDiff);
                            
                            if (dist < minDist1)
                            {
                                minDist2 = minDist1;
                                minDist1 = dist;
                            }
                            else if (dist < minDist2)
                            {
                                minDist2 = dist;
                            }
                        }
                    }
                }
            }
        }
    }
    
    float scale = numCells * 0.5;
    return saturate(float2(minDist1, minDist2) * scale);
}

// Perlin-like gradient noise for blending
float GradientNoise(float3 uvw, int frequency, int seed)
{
    float3 p = uvw * frequency;
    float3 f = frac(p);
    float3 i = floor(p);
    
    // Smooth interpolation
    float3 u = f * f * (3.0 - 2.0 * f);
    
    // Hash corners
    float n000 = dot(Hash3D(i + float3(0, 0, 0), seed) * 2.0 - 1.0, f - float3(0, 0, 0));
    float n100 = dot(Hash3D(i + float3(1, 0, 0), seed) * 2.0 - 1.0, f - float3(1, 0, 0));
    float n010 = dot(Hash3D(i + float3(0, 1, 0), seed) * 2.0 - 1.0, f - float3(0, 1, 0));
    float n110 = dot(Hash3D(i + float3(1, 1, 0), seed) * 2.0 - 1.0, f - float3(1, 1, 0));
    float n001 = dot(Hash3D(i + float3(0, 0, 1), seed) * 2.0 - 1.0, f - float3(0, 0, 1));
    float n101 = dot(Hash3D(i + float3(1, 0, 1), seed) * 2.0 - 1.0, f - float3(1, 0, 1));
    float n011 = dot(Hash3D(i + float3(0, 1, 1), seed) * 2.0 - 1.0, f - float3(0, 1, 1));
    float n111 = dot(Hash3D(i + float3(1, 1, 1), seed) * 2.0 - 1.0, f - float3(1, 1, 1));
    
    // Trilinear interpolation
    float nx00 = lerp(n000, n100, u.x);
    float nx10 = lerp(n010, n110, u.x);
    float nx01 = lerp(n001, n101, u.x);
    float nx11 = lerp(n011, n111, u.x);
    
    float nxy0 = lerp(nx00, nx10, u.y);
    float nxy1 = lerp(nx01, nx11, u.y);
    
    return lerp(nxy0, nxy1, u.z) * 0.5 + 0.5;
}

// Single octave Worley generation
[numthreads(8, 8, 8)]
void GenerateWorleyNoise(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_Resolution, _Resolution, _Resolution)))
        return;
    
    float3 uvw = (float3(id) + 0.5) / float(_Resolution);
    
    // Generate Worley noise at different frequencies for RGBA channels
    // R: Low frequency (base shape)
    // G: Medium frequency
    // B: High frequency
    // A: Perlin-Worley blend
    
    float worleyLow = WorleyNoise(uvw, _NumCells, _Seed);
    float worleyMed = WorleyNoise(uvw, _NumCells * 2, _Seed + 1);
    float worleyHigh = WorleyNoise(uvw, _NumCells * 4, _Seed + 2);
    
    // Invert Worley for cloud-like appearance (1 = dense, 0 = empty)
    worleyLow = 1.0 - worleyLow;
    worleyMed = 1.0 - worleyMed;
    worleyHigh = 1.0 - worleyHigh;
    
    // Create Perlin-Worley blend for alpha channel
    float perlin = GradientNoise(uvw, _NumCells, _Seed + 3);
    float perlinWorley = saturate(perlin * 0.5 + worleyLow * 0.5);
    
    _ResultTexture[id] = float4(worleyLow, worleyMed, worleyHigh, perlinWorley);
}

// Multi-octave FBM Worley noise
[numthreads(8, 8, 8)]
void GenerateMultiOctaveWorley(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(_Resolution, _Resolution, _Resolution)))
        return;
    
    float3 uvw = (float3(id) + 0.5) / float(_Resolution);
    
    // Generate FBM Worley for each channel
    float4 result = float4(0, 0, 0, 0);
    
    // Channel R: Base cloud shape (Perlin-Worley FBM)
    {
        float fbm = 0.0;
        float amplitude = 1.0;
        float totalAmplitude = 0.0;
        int freq = _NumCells;
        
        for (int o = 0; o < _Octaves; o++)
        {
            float worley = 1.0 - WorleyNoise(uvw, freq, _Seed + o);
            float perlin = GradientNoise(uvw, freq, _Seed + o + 100);
            
            // Perlin-Worley blend (more Perlin at low freq, more Worley at high freq)
            float blend = lerp(perlin, worley, float(o) / float(_Octaves));
            
            fbm += blend * amplitude;
            totalAmplitude += amplitude;
            amplitude *= _Persistence;
            freq *= 2;
        }
        
        result.r = fbm / totalAmplitude;
    }
    
    // Channel G: Detail noise 1 (pure Worley FBM)
    {
        float fbm = 0.0;
        float amplitude = 1.0;
        float totalAmplitude = 0.0;
        int freq = _NumCells * 2;
        
        for (int o = 0; o < min(_Octaves, 3); o++)
        {
            float worley = 1.0 - WorleyNoise(uvw, freq, _Seed + o + 200);
            fbm += worley * amplitude;
            totalAmplitude += amplitude;
            amplitude *= _Persistence;
            freq *= 2;
        }
        
        result.g = fbm / totalAmplitude;
    }
    
    // Channel B: Detail noise 2 (higher frequency Worley)
    {
        float fbm = 0.0;
        float amplitude = 1.0;
        float totalAmplitude = 0.0;
        int freq = _NumCells * 4;
        
        for (int o = 0; o < min(_Octaves, 3); o++)
        {
            float worley = 1.0 - WorleyNoise(uvw, freq, _Seed + o + 300);
            fbm += worley * amplitude;
            totalAmplitude += amplitude;
            amplitude *= _Persistence;
            freq *= 2;
        }
        
        result.b = fbm / totalAmplitude;
    }
    
    // Channel A: Cellular pattern (F2 - F1 for wispy details)
    {
        float2 f1f2 = WorleyNoiseF1F2(uvw, _NumCells * 2, _Seed + 400);
        result.a = saturate((f1f2.y - f1f2.x) * 2.0);
    }
    
    _ResultTexture[id] = result;
}