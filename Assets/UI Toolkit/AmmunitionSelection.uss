:root {
}

.button_large {
    align-content: center;
    align-self: center;
    justify-content: flex-start;
    align-items: center;
    width: 80px;
    height: 80px;
    margin-right: 20px;
    margin-left: 20px;
    -unity-material: url("");
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    flex-grow: 0;
}

.panel {
    flex-direction: row;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-bottom: 20px;
    margin-top: 0;
    justify-content: flex-start;
    align-self: center;
    align-content: center;
}

.button_small {
    width: 60px;
    height: 60px;
    margin-right: 20px;
    margin-left: 20px;
    font-size: 12px;
}

.buttonImage {
    width: 80px;
    height: 80px;
    -unity-material: url("project://database/Assets/Shaders/CreatedMaterials/MainGunSelectionBox.mat?fileID=2100000&guid=2dc70808a53ddd54381ba52c961a852a&type=2#MainGunSelectionBox");
    background-color: rgb(255, 255, 255);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    align-self: center;
    align-content: center;
}

.buttonLable {
    position: absolute;
    right: 0;
    top: 0;
    left: 0;
    bottom: 0;
    justify-content: center;
    align-self: center;
    align-content: center;
    align-items: center;
    color: rgb(255, 255, 255);
    font-size: 20px;
}


