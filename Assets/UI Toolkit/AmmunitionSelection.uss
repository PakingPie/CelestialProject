:root {
}

.button_large {
    align-content: center;
    align-self: auto;
    justify-content: flex-start;
    align-items: center;
    width: 80px;
    height: 80px;
    margin-right: 20px;
    margin-left: 20px;
}

.panel {
    flex-direction: row;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-bottom: 20px;
    margin-top: 0;
    justify-content: flex-start;
    align-self: center;
    align-content: center;
}

.button_small {
    width: 60px;
    height: 60px;
    margin-right: 20px;
    margin-left: 20px;
    font-size: 12px;
}
