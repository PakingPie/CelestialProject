    "m_ObjectId": "3172613b9dbe4e9f98b5236db79ced8a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Rhombus (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 121.60003662109375,
            "y": -156.80001831054688,
            "width": 220.0,
            "height": 117.60000610351563
        }
    },
    "m_Slots": [
        {
            "m_Id": "a85dd5ee07a047b796de069c85da961d"
        },
        {
            "m_Id": "4f2a0782ce9f44ed9f75e443f5c2ae49"
        },
        {
            "m_Id": "43d1579b28c446dfb6a7b51bed818f1f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Rhombus",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "b.y = - b.y;\np = abs(p);\nfloat h = clamp((dot(b, p) + b.y * b.y) / dot(b, b), 0.0, 1.0);\np -= b * float2(h, h-1.0);\noutput = length(p) * sign(p.x);"
}

