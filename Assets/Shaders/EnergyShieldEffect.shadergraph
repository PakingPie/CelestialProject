    "m_SourceType": 1,
    "m_FunctionName": "OutputColorGradient",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "if(input <= threshold1 && input > threshold2)\n{\n\toutput = color2;\n}\nelse if(input <= threshold2)\n{\n\toutput = color3;\n}\nelse\n{\n\toutput = color1;\n}"
}

