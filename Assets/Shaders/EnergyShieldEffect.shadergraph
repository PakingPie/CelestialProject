    },
    "m_SourceType": 1,
    "m_FunctionName": "isZLessThanZero",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "if(uv_z < 0)\nu = (1 - uv_u * 2) * 0.5 + 0.5;\nelse\nu = uv_u;"
}

